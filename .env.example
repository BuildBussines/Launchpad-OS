# Database — SQLite works with zero setup for local dev.
# For production, point this at Postgres (see DATABASE.md).
DATABASE_URL="file:./dev.db"

# Public site URL, used for Stripe success/cancel redirects.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Stripe (optional). Leave unset to use the built-in /checkout-demo flow.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Transactional email (optional, for wiring up /api/leads welcome emails).
RESEND_API_KEY=""
