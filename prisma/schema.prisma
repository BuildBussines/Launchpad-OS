// Launchpad OS — database schema
// Dev default: SQLite (zero setup). Swap the datasource below to postgresql
// for production — see DATABASE.md for the exact steps.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite" // change to "postgresql" for production, see DATABASE.md
  url      = env("DATABASE_URL")
}

// A captured email from the hero form, exit-intent, or any future lead
// magnet. Kept separate from Order so marketing capture never depends on
// a completed purchase.
model Lead {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String? // e.g. "hero", "exit-intent", "pricing"
  createdAt DateTime @default(now())

  // A lead converts into a customer once they complete checkout.
  order Order?

  @@index([createdAt])
}

// One row per completed (or attempted) purchase. Designed to sit behind a
// Stripe Checkout Session or similar — see /app/api/checkout/route.ts.
model Order {
  id                String      @id @default(cuid())
  email             String
  tier              ProductTier
  amountCents       Int
  currency          String      @default("usd")
  status            OrderStatus @default(PENDING)
  stripeSessionId   String?     @unique
  stripePaymentId   String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  lead   Lead?   @relation(fields: [leadId], references: [id])
  leadId String? @unique

  @@index([email])
  @@index([status])
}

enum ProductTier {
  STARTER
  PRO
  FOUNDER
}

enum OrderStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}
